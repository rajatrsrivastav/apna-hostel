# Copy to .env.local. Never commit actual secrets.
# Neon: pooled connection string, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=qKMhGzObaMq3fCq4cXNaABQmA4oDo/l2rKSxvNa+Gb0=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google account to promote AFTER its first verified Google sign-in.
ADMIN_EMAIL=
# Both keys must belong to the same Razorpay account and mode.
# Test: rzp_test_... / Live: rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A separate random webhook secret, not the Razorpay key secret.
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; shown as a call button on the student Help page.
HOSTEL_SUPPORT_PHONE=

# Protects the daily Vercel monthly-rent cron. Generate with openssl rand -hex 32.
CRON_SECRET=

# Temporary Razorpay reviewer access. Disable after verification.
ENABLE_RAZORPAY_REVIEW_LOGIN=false
# Use a dedicated email that is not ADMIN_EMAIL or an existing student's email.
RAZORPAY_REVIEW_EMAIL=
# Use a unique random password of at least 16 characters.
RAZORPAY_REVIEW_PASSWORD=

# Comma-separated verified Google emails; overrides ADMIN_EMAIL when set.
ADMIN_EMAILS=

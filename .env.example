# Copy to .env.local. Never commit actual secrets.
# Neon: pooled connection string, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google account to promote AFTER its first verified Google sign-in.
ADMIN_EMAIL=
# Cashfree Payment Gateway credentials.
# Sandbox: test_... / Production: prod_...
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' for testing, 'production' for live
CASHFREE_ENV=sandbox
# HMAC-SHA256 secret configured in Cashfree dashboard → Webhooks
CASHFREE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; shown as a call button on the student Help page.
HOSTEL_SUPPORT_PHONE=

# Protects the daily Vercel monthly-rent cron. Generate with openssl rand -hex 32.
CRON_SECRET=

# Comma-separated verified Google emails; overrides ADMIN_EMAIL when set.
ADMIN_EMAILS=

# Transactional emails via Resend (server-only; never expose to client)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Apna Hostel <noreply@apnahostel.in>"

# Enable review login for Cashfree verification
ENABLE_CASHFREE_REVIEW_LOGIN=true
CASHFREE_REVIEW_EMAIL=cashfree.reviewer@example.com
CASHFREE_REVIEW_PASSWORD=f479edda035d384cebeecd607bb7382d

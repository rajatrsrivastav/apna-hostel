# Configure these in Vercel's Production environment. Never commit real values.
# Database: pooled PostgreSQL URL with TLS (e.g. sslmode=require).
DATABASE_URL=
# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical public HTTPS origin, with no path/query. No localhost or tunnel URLs.
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google accounts that may administer the hostel.
ADMIN_EMAILS=
# Optional legacy alternative, used only when ADMIN_EMAILS is not set.
ADMIN_EMAIL=

# Production Cashfree credentials; also used to verify webhook signatures.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Private authenticated payment screenshot storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required to deliver notifications. Sender must use a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# At least 32 random characters. Used by both Vercel cron endpoints.
CRON_SECRET=

# Keep reviewer sign-in available for Cashfree KYC; use existing secure credentials.
ENABLE_CASHFREE_REVIEW_LOGIN=true
CASHFREE_REVIEW_EMAIL=
# At least 16 characters; never use a sample password.
CASHFREE_REVIEW_PASSWORD=

# Optional student Help page contact number.
HOSTEL_SUPPORT_PHONE=
